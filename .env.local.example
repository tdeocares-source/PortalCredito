# =============================================================================
# Portal Crédito — variables de entorno
# Copia este archivo a `.env.local` y completá los valores.
# `.env.local` está en .gitignore — NUNCA lo commitees.
# =============================================================================

# ─── Supabase ────────────────────────────────────────────────────────────────
# Proyecto Supabase dedicado al Portal Crédito (NO compartir con la plataforma
# interna). Crear en https://supabase.com/dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxx

# Service role key: solo en server actions / route handlers. Nunca exponer al
# cliente. Necesaria para upserts que bypassen RLS (p. ej. crear `solicitudes`
# antes de que el cliente se autentique con magic link).
# Dashboard → Project Settings → API Keys → "secret" (sb_secret_…) o el
# legacy "service_role" (JWT que empieza con eyJhbGc…).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Resend (email transaccional) ────────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Dominio verificado en Resend. Mientras no esté verificado, el "from" debe ser
# el email de tu cuenta Resend (Resend solo permite envíos al mismo email).
RESEND_FROM_EMAIL=Portal Crédito <onboarding@example.com>

# ─── PostHog (tracking) ──────────────────────────────────────────────────────
# https://app.posthog.com → Project settings → Project API key
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── App ─────────────────────────────────────────────────────────────────────
# URL pública del portal (sin trailing slash). Se usa para construir el link
# del magic link y el callback de auth. En dev: http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
